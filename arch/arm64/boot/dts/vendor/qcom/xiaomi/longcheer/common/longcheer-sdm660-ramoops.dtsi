/* ramoops dts configuration */
&reserved_mem {
	ramoops {
		status = "ok";
		compatible = "ramoops", "removed-dma-pool";
		no-map;
		reg = <0x0 0x88F00000 0x0 0x00400000>;
		console-size = <0x100000>;
		pmsg-size = <0x100000>;
		record-size = <0x100000>;
		max-reason = <0x4>;
	};
};
