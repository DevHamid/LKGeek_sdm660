diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index aa4a13eb..3de7f36f 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -345,7 +345,7 @@ long ksu_handle_execveat_sucompat_internal(const char __user **filename_user, in
 static inline int do_ksu_handle_execveat_sucompat(int *fd, const char *filename, struct user_arg_ptr *argv)
 {
     struct ksu_sulog_pending_event *pending_sucompat = NULL;
